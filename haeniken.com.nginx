server {
    listen 80;
    server_name www.haeniken.com;
    server_tokens off;

    include cloudflare;
    return 301 https://haeniken.com$request_uri;
}

server {
    listen 80;
    server_name haeniken.com;
    server_tokens off;

    access_log /var/log/nginx/haeniken.com.access.log;
    error_log /var/log/nginx/haeniken.com.error.log;

    include cloudflare;

    location = /robots.txt {
        proxy_pass http://127.0.0.1:18110;
        include proxy_params;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:18110;
        include proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:18110;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
